[node name="BoardSystemWaveIntegration" type="Node2D"]

[node name="Wave" parent="." instance=ExtResource("1_wave")]

[node name="BoardLayout" parent="." instance=ExtResource("2_layout")]

[node name="BoardWavePlacementBridge" type="Node" parent="."]
