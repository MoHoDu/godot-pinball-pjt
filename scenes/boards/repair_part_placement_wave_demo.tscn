[ext_resource type="PackedScene" path="res://Resources/boards/crescent_needle_placeable.tscn" id="14_needle_scene"]
[ext_resource type="PackedScene" path="res://Resources/boards/forgotten_star_bell_placeable.tscn" id="15_bell_scene"]

[sub_resource type="Resource" id="Entry_brooch"]
script = ExtResource("7_entry")
