[node name="RepairPartPlacementWaveDemo" type="Node2D"]

[node name="Wave" parent="." instance=ExtResource("1_wave")]

[node name="BoardLayout" parent="." instance=ExtResource("2_layout")]

[node name="RepairPartInventory" type="Node" parent="."]
script = ExtResource("6_inventory")
entries = Array[ExtResource("7_entry")]([SubResource("Entry_brooch"), SubResource("Entry_gears"), SubResource("Entry_needle"), SubResource("Entry_bell")])

[node name="PlacementHUD" type="CanvasLayer" parent="."]
layer = 50

[node name="RepairPartPlacementHud" parent="PlacementHUD" instance=ExtResource("3_hud")]

[node name="BoardWavePlacementBridge" type="Node" parent="." node_paths=PackedStringArray("wave_manager", "placement_session", "combo_system", "wave_hud", "ball_selection_hud", "placement_hud")]
script = ExtResource("4_bridge")
wave_manager = NodePath("../Wave/WaveManager")
placement_session = NodePath("../BoardLayout/PlacementSession")
combo_system = NodePath("../Wave/ComboSystem")
wave_hud = NodePath("../Wave/HUD/WaveHud")
ball_selection_hud = NodePath("../Wave/HUD/BallSelectionHud")
placement_hud = NodePath("../PlacementHUD/RepairPartPlacementHud")

[node name="RepairPartPlacementController" type="Node" parent="." node_paths=PackedStringArray("placement_session", "inventory", "placement_hud", "wave_bridge")]
script = ExtResource("5_controller")
placement_session = NodePath("../BoardLayout/PlacementSession")
inventory = NodePath("../RepairPartInventory")
placement_hud = NodePath("../PlacementHUD/RepairPartPlacementHud")
wave_bridge = NodePath("../BoardWavePlacementBridge")
