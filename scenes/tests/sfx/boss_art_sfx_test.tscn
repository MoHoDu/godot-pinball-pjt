[gd_scene load_steps=7 format=3]

; 보스 애니메이션 + 사운드 검수 씬입니다.
;
; ★ 아트 쪽 검수 씬(scenes/boss_system/boss_art_test.tscn)을 **상속**하고
;   컨트롤러만 소리 얹은 파생(boss_art_sfx_controller.gd)으로 바꿉니다.
;   리그·배치·라벨은 원본 그대로입니다.
;
; 조작 (원본 그대로) — 애니메이션과 소리가 같은 순간에 나옵니다.
;   1 대기 · 2 예고(실 끼익) · 3 공격(천 휙+턱) · 4 경직 ·
;   5 피격(팡) · 6 강한 피격 · 7 포효(뒤틀린 오르골) · Space 시퀀스

[ext_resource type="PackedScene" path="res://scenes/tests/boss/boss_art_test.tscn" id="1_base"]
[ext_resource type="Script" path="res://tests/sfx_system/boss_art_sfx_controller.gd" id="2_ctrl"]
[ext_resource type="Script" path="res://scripts/sfx_system/sfx_director.gd" id="3_director"]
[ext_resource type="Resource" path="res://settings/sfx/BossSfxRules.tres" id="4_rules"]
[ext_resource type="Script" path="res://scripts/sfx_system/bgm_player.gd" id="5_bgm"]
[ext_resource type="AudioStream" path="res://Resources/sfx/bgm/BGM_Boss_Loop.wav" id="6_boss_loop"]

[node name="BossArtTest" instance=ExtResource("1_base")]
script = ExtResource("2_ctrl")
boss_rules = ExtResource("4_rules")

[node name="SfxDirector" type="Node" parent="."]
script = ExtResource("3_director")

[node name="BgmPlayer" type="AudioStreamPlayer" parent="."]
stream = ExtResource("6_boss_loop")
volume_db = -2.0
script = ExtResource("5_bgm")
