[gd_scene load_steps=6 format=3]

; 범퍼 사운드 검수 씬입니다.
;
; ★ 아트 쪽 VFX 테스트 씬(scenes/bumper_system/vfx/bumper_vfx_test.tscn)을
;   **상속**해서 SfxDirector 와 바인더 두 노드만 더합니다.
;   범퍼 배치·낙하 리그·HUD 는 이미 거기 다 있으므로 다시 만들지 않습니다.
;
; 조작은 원본 그대로입니다.
;   ←/→ 또는 A/D  범퍼 선택      SPACE/ENTER  공 낙하
;   R  같은 범퍼 재시작           캐논: W/A/D + SPACE
;
; 공이 실제로 범퍼에 떨어지므로 소리가 **게임과 같은 경로**로 납니다.
; response_resolved · state_changed · control_started/ended 가 그대로 울립니다.

[ext_resource type="PackedScene" path="res://scenes/tests/bumpers/bumper_vfx_test.tscn" id="1_vfx"]
[ext_resource type="Script" path="res://scripts/sfx_system/sfx_director.gd" id="2_director"]
[ext_resource type="Script" path="res://scripts/sfx_system/wave_sfx_binder_strict.gd" id="3_binder"]
[ext_resource type="Resource" path="res://settings/sfx/BumperSfxRules.tres" id="4_bumper"]
[ext_resource type="Script" path="res://tests/sfx_system/sfx_debug_hud.gd" id="5_hud"]

[node name="BumperTest" instance=ExtResource("1_vfx")]

[node name="SfxDirector" type="Node" parent="."]
script = ExtResource("2_director")

[node name="_WaveSfxBinder" type="Node" parent="."]
script = ExtResource("3_binder")
bumper_rules = ExtResource("4_bumper")

[node name="_SfxDebugHud" type="CanvasLayer" parent="."]
layer = 2
script = ExtResource("5_hud")
director_path = NodePath("../SfxDirector")
