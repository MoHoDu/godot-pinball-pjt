# Godot 4+ specific ignores
.godot/
/android/

# Import metadata for folders excluded from Godot's resource scan.
/docs/**/*.import
/tmp/**/*.import
/tests/evidence/**/*.import

# Python 캐시 (SFX 재현 스크립트)
__pycache__/
*.pyc

# 로컬 비밀값 (ElevenLabs API 키 등)
.env.local

# 오디션은 검수용 산출물이다. build_*.py 로 언제든 다시 만들어진다
docs/sfx/audition/
