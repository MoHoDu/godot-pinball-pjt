[gd_resource type="Resource" script_class="RewardShopCatalog" load_steps=13 format=3]

[ext_resource type="Script" path="res://scripts/reward_shop/reward_shop_catalog.gd" id="1_catalog"]
[ext_resource type="Script" path="res://scripts/reward_shop/reward_ball_offer.gd" id="2_ball"]
[ext_resource type="Script" path="res://scripts/reward_shop/repair_part_offer.gd" id="3_part"]

[sub_resource type="Resource" id="Ball_clockwork"]
script = ExtResource("2_ball")
ball_id = &"clockwork"
display_name = "정속 태엽눈"
price = 13
performance_group = 0
merit_text = "속도 폭주가 적어 경로를 읽기 쉽습니다."
cost_text = "긴 고속 콤보의 고점은 낮습니다."

[sub_resource type="Resource" id="Ball_rubber"]
script = ExtResource("2_ball")
ball_id = &"rubber"
display_name = "고무막 유리눈"
price = 14
performance_group = 0
merit_text = "빠르게 목표 점수에 도달하고 고점이 높습니다."
cost_text = "튐이 커서 경로 통제가 어렵습니다."

[sub_resource type="Resource" id="Ball_gel"]
script = ExtResource("2_ball")
ball_id = &"gel"
display_name = "완충 젤 유리눈"
price = 11
performance_group = 1
merit_text = "생존 안정성이 높아 오래 살아남습니다."
cost_text = "점수 생산이 느립니다."

[sub_resource type="Resource" id="Ball_lead"]
script = ExtResource("2_ball")
ball_id = &"lead"
display_name = "납심 유리눈"
price = 9
performance_group = 2
merit_text = "묵직한 관성으로 정밀한 조준이 가능합니다."
cost_text = "평균 안정성이 낮아 숙련이 필요합니다."

[sub_resource type="Resource" id="Ball_hollow_bell"]
script = ExtResource("2_ball")
ball_id = &"hollow_bell"
display_name = "속빈 방울눈"
price = 9
performance_group = 2
merit_text = "예측 밖 반동으로 뜻밖의 고점을 만듭니다."
cost_text = "결과 편차와 통제 난도가 높습니다."

[sub_resource type="Resource" id="Part_star_brooch"]
script = ExtResource("3_part")
part_id = &"starlight_brooch"
display_name = "별빛 브로치"
bundle_count = 1
price = 11
verb_text = "완성한다"
condition_text = "6초 안에 서로 다른 부품 2종을 방문한 뒤 브로치로 돌아오면"
effect_text = "완성 타격 1회"
works_standalone = false
needs_partner = true

[sub_resource type="Resource" id="Part_clockwork_gear"]
script = ExtResource("3_part")
part_id = &"golden_gears"
display_name = "황금 톱니바퀴"
bundle_count = 2
price = 12
verb_text = "감고 터뜨린다"
condition_text = "공이 접촉하면"
effect_text = "접촉 시 +90px/s, 2.4초 내 3번째 접촉에 +180px/s 과회전"
works_standalone = true
needs_partner = false

[sub_resource type="Resource" id="Part_curved_needle"]
script = ExtResource("3_part")
part_id = &"crescent_needle"
display_name = "초승달 바늘"
bundle_count = 2
price = 10
verb_text = "잇는다"
condition_text = "접촉 후 3초 안에 다른 부품을 맞히면"
effect_text = "추가 콤보 1회"
works_standalone = false
needs_partner = true

[sub_resource type="Resource" id="Part_bell"]
script = ExtResource("3_part")
part_id = &"forgotten_star_bell"
display_name = "잊혀진 별방울"
bundle_count = 3
price = 9
verb_text = "늦게 울린다"
condition_text = "공이 접촉하고 0.60초 뒤"
effect_text = "콤보 유지용 여운 타격 1회"
works_standalone = true
needs_partner = false

[resource]
script = ExtResource("1_catalog")
ball_offers = Array[ExtResource("2_ball")]([SubResource("Ball_clockwork"), SubResource("Ball_rubber"), SubResource("Ball_gel"), SubResource("Ball_lead"), SubResource("Ball_hollow_bell")])
part_offers = Array[ExtResource("3_part")]([SubResource("Part_star_brooch"), SubResource("Part_clockwork_gear"), SubResource("Part_curved_needle"), SubResource("Part_bell")])
