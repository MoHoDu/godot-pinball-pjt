[gd_resource type="Resource" script_class="BumperSettings" load_steps=2 format=3]

; 대각 벽에 밀착하는 반원 돔 리바운드 범퍼.
; test/ReboundTestBumper.tres 를 정식화한 것으로, 벽 부착물이라
; 사실상 부서지지 않게 내구도를 높게 둔다.
; 2026-08-09 형락님 지시로 삼각형 → 반원, 튕김 1.35→1.5 / 최소 방출 1000→1150 강화.
; 웨이브 로드아웃 검증 대상이 아니다 — Bumpers 루트가 아닌 Walls 아래에 배치된다.

[ext_resource type="Script" path="res://scripts/bumper-system/bumper_settings.gd" id="1"]

