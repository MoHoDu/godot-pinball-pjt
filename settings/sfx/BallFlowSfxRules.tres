[gd_resource type="Resource" script_class="BallFlowSfxRules" load_steps=6 format=3]

; 공의 생애 규칙 — 발사 · 낙하 · 선택.
;
; ★ 발사음만 speed_volume_range 가 살아 있다. 살짝 당긴 것과 끝까지 당긴 것이
;   같은 소리면 조작 피드백이 죽는다. `ball_launched(ball, dir, speed)` 가
;   speed 를 준다.
;
; ★ 낙하·선택은 세기 개념이 없어 (0,0) 으로 잠근다.
;
; 낙하음은 벽 충돌 소재에 피치 하강을 걸어 만들었다. 같은 보드에서 공이
; 사라지는 것으로 들려야 하기 때문이다. docs/sfx/build_ball_group.py 참고.

[ext_resource type="Script" path="res://scripts/sfx_system/rules/ball_flow_sfx_rules.gd" id="1_rules"]
[ext_resource type="Script" path="res://scripts/sfx_system/sfx_cue.gd" id="2_cue"]
[ext_resource type="AudioStream" path="res://Resources/sfx/balls/SFX_Ball_Launch.wav" id="3_launch"]
[ext_resource type="AudioStream" path="res://Resources/sfx/balls/SFX_Ball_Drain.wav" id="4_drain"]
[ext_resource type="AudioStream" path="res://Resources/sfx/balls/SFX_Ball_Select.wav" id="5_select"]

[sub_resource type="Resource" id="Cue_launch"]
script = ExtResource("2_cue")
cue_id = &"ball_launch"
role = "공 발사 — 태엽이 풀리며 튕겨나간다. 세기는 당긴 힘이 정한다"
streams = Array[AudioStream]([ExtResource("3_launch")])
selection_mode = 0
priority = 20
maximum_concurrent = 2
base_volume_db = 0.0
speed_reference_range = Vector2(300, 2000)
speed_volume_range = Vector2(-9, 0)
pitch_jitter = 0.03
minimum_repeat_interval = 0.12
repeat_attenuation_db = 0.0

[sub_resource type="Resource" id="Cue_drain"]
script = ExtResource("2_cue")
cue_id = &"ball_drain"
role = "공 낙하 — 공을 잃는다. 음이 아래로 미끄러진다"
streams = Array[AudioStream]([ExtResource("4_drain")])
selection_mode = 0
priority = 20
maximum_concurrent = 1
base_volume_db = 0.0
speed_volume_range = Vector2(0, 0)
pitch_jitter = 0.02
minimum_repeat_interval = 0.3
repeat_attenuation_db = 0.0

[sub_resource type="Resource" id="Cue_select"]
script = ExtResource("2_cue")
cue_id = &"ball_select"
role = "공 선택 — 웨이브 시작 시 공을 고른다. 조작 확인음"
streams = Array[AudioStream]([ExtResource("5_select")])
selection_mode = 0
priority = 0
maximum_concurrent = 2
base_volume_db = 0.0
speed_volume_range = Vector2(0, 0)
pitch_jitter = 0.04
minimum_repeat_interval = 0.08
repeat_attenuation_db = -2.0

[resource]
script = ExtResource("1_rules")
launch_cue = SubResource("Cue_launch")
drain_cue = SubResource("Cue_drain")
select_cue = SubResource("Cue_select")
minimum_launch_speed = 300.0
maximum_launch_speed = 2000.0
