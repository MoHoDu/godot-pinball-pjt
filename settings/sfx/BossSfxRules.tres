[resource]
script = ExtResource("1_rules")
telegraph_cue = SubResource("SfxCue_tel")
arm_swing_cue = SubResource("SfxCue_swing")
hit_cue = SubResource("SfxCue_hit")
roar_cue = SubResource("SfxCue_roar")
cotton_telegraph_cue = SubResource("SfxCue_blink")
