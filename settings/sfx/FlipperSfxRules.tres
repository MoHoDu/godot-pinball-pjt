[sub_resource type="Resource" id="Cue_activate_cue"]
script = ExtResource("2_cue")
cue_id = &"flipper_activate"
role = "플리퍼 작동 — Space 로 올라간다. 공을 못 맞혀도 난다"
streams = Array[AudioStream]([ExtResource("4_snd")])
speed_tier_thresholds = PackedFloat32Array(420, 1050)
maximum_concurrent = 3
speed_volume_range = Vector2(0, 0)
pitch_jitter = 0.05
minimum_repeat_interval = 0.04
repeat_attenuation_db = -3.0
repeat_attenuation_floor_db = -6.0
repeat_chain_reset_time = 0.24

[sub_resource type="Resource" id="Cue_hit_cue"]
script = ExtResource("2_cue")
cue_id = &"flipper_hit"
role = "플리퍼 일반 타격 — 유리공을 친다. 단단한 톡/탁 (기획서 MUST)"
streams = Array[AudioStream]([ExtResource("5_snd")])
speed_tier_thresholds = PackedFloat32Array(420, 1050)
priority = 30
maximum_concurrent = 3
speed_reference_range = Vector2(200, 1200)
speed_volume_range = Vector2(-3, 0)
pitch_jitter = 0.05
minimum_repeat_interval = 0.04
repeat_attenuation_db = -3.0
repeat_attenuation_floor_db = -6.0
repeat_chain_reset_time = 0.24

