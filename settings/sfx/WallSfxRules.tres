[gd_resource type="Resource" script_class="WallSfxRules" load_steps=6 format=3]

; 벽 충돌 규칙. 기획서 p.62 규격을 그대로 옮긴다.
;
; ★ 3종은 **랜덤이 아니라 속도 구간별**이다 (selection_mode = SPEED_TIER).
;   랜덤이면 느리게 스친 공에서 고속 음색이 나서 세기가 거꾸로 읽힌다.
;   경계는 420 · 1050 px/s.
;
; ★ 세 파일의 피크는 같다(-10dB). 세기 차이는 speed_volume_range 가 만든다.
;   파일에 세기를 구우면 이중 적용이 된다.
;
; 최대 동시 4개 · 최소 간격 0.04초 · 연타 -3dB(바닥 -9dB) · 피치 ±5%

[ext_resource type="Script" path="res://scripts/sfx_system/rules/wall_sfx_rules.gd" id="1_rules"]
[ext_resource type="Script" path="res://scripts/sfx_system/sfx_cue.gd" id="2_cue"]
[ext_resource type="AudioStream" path="res://Resources/sfx/walls/SFX_Wall_Hit_Low.wav" id="3_low"]
[ext_resource type="AudioStream" path="res://Resources/sfx/walls/SFX_Wall_Hit_Mid.wav" id="4_mid"]
[ext_resource type="AudioStream" path="res://Resources/sfx/walls/SFX_Wall_Hit_High.wav" id="5_high"]

[sub_resource type="Resource" id="Cue_wall_hit"]
script = ExtResource("2_cue")
cue_id = &"wall_hit"
role = "벽 충돌 — 유리공이 보드 프레임에 부딪힌다. 저·중·고속 3종"
streams = Array[AudioStream]([ExtResource("3_low"), ExtResource("4_mid"), ExtResource("5_high")])
selection_mode = 1
speed_tier_thresholds = PackedFloat32Array(420, 1050)
priority = 10
maximum_concurrent = 4
base_volume_db = 0.0
speed_reference_range = Vector2(120, 900)
speed_volume_range = Vector2(-14, 0)
pitch_jitter = 0.05
minimum_repeat_interval = 0.04
repeat_attenuation_db = -3.0
repeat_attenuation_floor_db = -9.0

[resource]
script = ExtResource("1_rules")
hit_cue = SubResource("Cue_wall_hit")
