[gd_resource type="Resource" script_class="BumperSfxRules" load_steps=11 format=3]

; 범퍼 SFX — 기획서 3층 구조 중 재질음.
;
; ★ 5종이 서로 확실히 갈려야 합니다.
;   음색이 겹치면 무엇을 맞혔는지 화면을 봐야 압니다.
;   단추(딱) / 솜(푹) / 용수철(끽팡) / 북(통) / 대포(철컥)
;
; 대체 큐(fallback)는 단추를 씁니다. 새 범퍼가 늘어도 무음이 되지 않습니다.
;
; dB 서열은 파일 피크가 갖고 있습니다.
;   단추 -6 / 솜 -9 / 용수철 -6 / 북 -6 / 대포조작 -12 / 대포발사 -5
;   파괴 -4 / 리스폰 -13

[ext_resource type="Script" path="res://scripts/sfx_system/rules/bumper_sfx_rules.gd" id="1_rules"]
[ext_resource type="Script" path="res://scripts/sfx_system/sfx_cue.gd" id="2_cue"]
[ext_resource type="AudioStream" path="res://Resources/sfx/bumpers/SFX_Bumper_Button.wav" id="3_button"]
[ext_resource type="AudioStream" path="res://Resources/sfx/bumpers/SFX_Bumper_Cotton.wav" id="4_cotton"]
[ext_resource type="AudioStream" path="res://Resources/sfx/bumpers/SFX_Bumper_Spring.wav" id="5_spring"]
[ext_resource type="AudioStream" path="res://Resources/sfx/bumpers/SFX_Bumper_Drum.wav" id="6_drum"]
[ext_resource type="AudioStream" path="res://Resources/sfx/bumpers/SFX_Bumper_CannonClick.wav" id="7_click"]
[ext_resource type="AudioStream" path="res://Resources/sfx/bumpers/SFX_Bumper_CannonAim.wav" id="11_aim"]
[ext_resource type="AudioStream" path="res://Resources/sfx/bumpers/SFX_Bumper_CannonFire.wav" id="8_fire"]
[ext_resource type="AudioStream" path="res://Resources/sfx/bumpers/SFX_Bumper_Respawn.wav" id="10_respawn"]

[sub_resource type="Resource" id="SfxCue_button"]
script = ExtResource("2_cue")
cue_id = &"bumper_button"
role = "단추 범퍼 — 딱. 큰 플라스틱 단추가 눌린다"
streams = Array[AudioStream]([ExtResource("3_button")])
selection_mode = 0
priority = 20
maximum_concurrent = 3
speed_reference_range = Vector2(120, 900)
speed_volume_range = Vector2(-8, 0)
pitch_jitter = 0.05
minimum_repeat_interval = 0.05
repeat_attenuation_db = -3.0

