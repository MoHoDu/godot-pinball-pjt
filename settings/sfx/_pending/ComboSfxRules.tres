[gd_resource type="Resource" script_class="ComboSfxRules" load_steps=9 format=3]

; 콤보·웨이브 SFX.
;
; ★ 상승음(rise)의 pitch_jitter 를 0 으로 잠급니다.
;   피치가 곧 의미인 소리라 랜덤이 겹치면 계단이 흔들려
;   "쌓이고 있다"가 안 읽힙니다. 피치는 바인더가 콤보 수로 넣습니다.
;
; ★ 상승음은 전체에서 가장 작습니다(파일 피크 -15dBFS).
;   한 콤보에 수십 번 납니다. 크면 몇 초 만에 귀가 지칩니다.
;   최소 간격도 0.05 로 짧게 둡니다 — 연타가 곧 콤보라서 막으면 안 됩니다.

[ext_resource type="Script" path="res://scripts/sfx_system/rules/combo_sfx_rules.gd" id="1_rules"]
[ext_resource type="Script" path="res://scripts/sfx_system/sfx_cue.gd" id="2_cue"]
[ext_resource type="AudioStream" path="res://Resources/sfx/combo/SFX_Combo_Rise.wav" id="3_rise"]
[ext_resource type="AudioStream" path="res://Resources/sfx/combo/SFX_Combo_Tier.wav" id="4_tier"]
[ext_resource type="AudioStream" path="res://Resources/sfx/combo/SFX_Combo_Timeout.wav" id="5_timeout"]
[ext_resource type="AudioStream" path="res://Resources/sfx/combo/SFX_Combo_Target.wav" id="6_target"]
[ext_resource type="AudioStream" path="res://Resources/sfx/wave/SFX_Wave_Win.wav" id="7_win"]
[ext_resource type="AudioStream" path="res://Resources/sfx/wave/SFX_Wave_Lose.wav" id="8_lose"]

[sub_resource type="Resource" id="SfxCue_rise"]
script = ExtResource("2_cue")
cue_id = &"combo_rise"
role = "콤보 상승 — 유효 타격마다. 콤보가 오를수록 피치가 올라간다"
streams = Array[AudioStream]([ExtResource("3_rise")])
selection_mode = 0
priority = 0
maximum_concurrent = 3
base_volume_db = 0.0
speed_volume_range = Vector2(0, 0)
pitch_jitter = 0.0
minimum_repeat_interval = 0.05
repeat_attenuation_db = 0.0

[sub_resource type="Resource" id="SfxCue_tier"]
script = ExtResource("2_cue")
cue_id = &"combo_tier"
role = "콤보 단계 상승 — 상승음보다 크고 밝게"
streams = Array[AudioStream]([ExtResource("4_tier")])
selection_mode = 0
priority = 20
maximum_concurrent = 2
base_volume_db = 0.0
speed_volume_range = Vector2(0, 0)
pitch_jitter = 0.02
minimum_repeat_interval = 0.15
repeat_attenuation_db = 0.0

[sub_resource type="Resource" id="SfxCue_timeout"]
script = ExtResource("2_cue")
cue_id = &"combo_timeout"
role = "콤보 실패 — 시간이 끊겨 점수 없이 끝남"
streams = Array[AudioStream]([ExtResource("5_timeout")])
selection_mode = 0
priority = 20
maximum_concurrent = 1
base_volume_db = 0.0
speed_volume_range = Vector2(0, 0)
pitch_jitter = 0.02
minimum_repeat_interval = 0.3
repeat_attenuation_db = 0.0

[sub_resource type="Resource" id="SfxCue_target"]
script = ExtResource("2_cue")
cue_id = &"combo_target"
role = "목표 점수 도달 — 밝은 성취"
streams = Array[AudioStream]([ExtResource("6_target")])
selection_mode = 0
priority = 20
maximum_concurrent = 1
base_volume_db = 0.0
speed_volume_range = Vector2(0, 0)
pitch_jitter = 0.0
minimum_repeat_interval = 0.5
repeat_attenuation_db = 0.0

[sub_resource type="Resource" id="SfxCue_win"]
script = ExtResource("2_cue")
cue_id = &"wave_won"
role = "웨이브 승리 — 저주가 풀림. 오르골 한 음"
streams = Array[AudioStream]([ExtResource("7_win")])
selection_mode = 0
priority = 30
maximum_concurrent = 1
base_volume_db = 0.0
speed_volume_range = Vector2(0, 0)
pitch_jitter = 0.0
minimum_repeat_interval = 1.0
repeat_attenuation_db = 0.0

[sub_resource type="Resource" id="SfxCue_lose"]
script = ExtResource("2_cue")
cue_id = &"wave_lost"
role = "웨이브 패배 — 공을 다 씀. 태엽이 멈춘다"
streams = Array[AudioStream]([ExtResource("8_lose")])
selection_mode = 0
priority = 30
maximum_concurrent = 1
base_volume_db = 0.0
speed_volume_range = Vector2(0, 0)
pitch_jitter = 0.0
minimum_repeat_interval = 1.0
repeat_attenuation_db = 0.0

[resource]
script = ExtResource("1_rules")
rise_cue = SubResource("SfxCue_rise")
tier_cue = SubResource("SfxCue_tier")
timeout_cue = SubResource("SfxCue_timeout")
target_reached_cue = SubResource("SfxCue_target")
pitch_step = 0.06
maximum_pitch = 2.0
wave_won_cue = SubResource("SfxCue_win")
wave_lost_cue = SubResource("SfxCue_lose")
